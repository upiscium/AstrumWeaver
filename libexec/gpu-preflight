#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

die() {
  printf '[astrumweaver-gpu-preflight] ERROR: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 1 ]] || die "usage: gpu-preflight EXPECTED_UUID_FILE"
EXPECTED_FILE="$1"
[[ -f "$EXPECTED_FILE" ]] || die "expected GPU UUID file is missing"

MODE="${ASTRUMWEAVER_GPU_PREFLIGHT_MODE:-exact-visible}"
NVIDIA_SMI="${ASTRUMWEAVER_NVIDIA_SMI:-$(command -v nvidia-smi || true)}"
[[ -n "$NVIDIA_SMI" ]] || die "nvidia-smi is not available"

if [[ "$MODE" == "isolated-access" ]]; then
  REVIEWED_MAP="${ASTRUMWEAVER_GPU_DEVICE_MAP:-}"
  WORKER_CONFIG="${ASTRUMWEAVER_GPU_WORKER_CONFIG:-}"
  GPU_DEVICE_MAP="${ASTRUMWEAVER_GPU_DEVICE_MAP_COMMAND:-}"

  [[ "$REVIEWED_MAP" == /* && -f "$REVIEWED_MAP" ]] \
    || die "isolated-access reviewed GPU map is unavailable"
  [[ "$WORKER_CONFIG" == /* && -f "$WORKER_CONFIG" ]] \
    || die "isolated-access Worker config is unavailable"
  [[ "$GPU_DEVICE_MAP" == /* && -x "$GPU_DEVICE_MAP" ]] \
    || die "isolated-access canonical GPU mapper is unavailable"

  "$GPU_DEVICE_MAP" \
    --nvidia-smi "$NVIDIA_SMI" \
    verify-isolated-access \
    "$EXPECTED_FILE" \
    "$REVIEWED_MAP" \
    "$WORKER_CONFIG" >/dev/null

  count="$(awk 'NF {n++} END {print n+0}' "$EXPECTED_FILE")"
  printf '[astrumweaver-gpu-preflight] isolated-access ok count=%s\n' "$count"
  exit 0
fi

[[ "$MODE" == "exact-visible" ]] \
  || die "GPU preflight mode must be exact-visible or isolated-access"

expected_tmp="$(mktemp)"
observed_tmp="$(mktemp)"
cleanup() {
  rm -f "$expected_tmp" "$observed_tmp"
}
trap cleanup EXIT

awk 'NF { gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print }' "$EXPECTED_FILE" | sort >"$expected_tmp"
[[ -s "$expected_tmp" ]] || die "expected GPU UUID set is empty"

if [[ -n "$(uniq -d "$expected_tmp")" ]]; then
  die "expected GPU UUID file contains duplicates"
fi

"$NVIDIA_SMI" --query-gpu=uuid --format=csv,noheader \
  | awk 'NF { gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print }' \
  | sort >"$observed_tmp"

[[ -s "$observed_tmp" ]] || die "no GPUs were observed"
if [[ -n "$(uniq -d "$observed_tmp")" ]]; then
  die "observed GPU UUID set contains duplicates"
fi

if ! cmp -s "$expected_tmp" "$observed_tmp"; then
  expected_count="$(wc -l <"$expected_tmp" | tr -d ' ')"
  observed_count="$(wc -l <"$observed_tmp" | tr -d ' ')"
  die "GPU UUID set mismatch (expected_count=$expected_count observed_count=$observed_count)"
fi

count="$(wc -l <"$expected_tmp" | tr -d ' ')"
printf '[astrumweaver-gpu-preflight] ok count=%s\n' "$count"
