#!/usr/bin/env python3
"""Read canonical Worker GPU ownership/preflight fields from worker.toml."""

from __future__ import annotations

import argparse
import sys
import tomllib
from pathlib import Path


def load_worker(path: Path) -> dict[str, object]:
    try:
        with path.open("rb") as handle:
            config = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise ValueError(f"cannot read Worker config: {path}") from exc

    worker = config.get("worker")
    if not isinstance(worker, dict):
        raise ValueError("Worker config must contain a [worker] table")
    return worker


def load_gpu_uuids(worker: dict[str, object]) -> tuple[str, ...]:
    raw = worker.get("gpu_uuids")
    if not isinstance(raw, list):
        raise ValueError("worker.gpu_uuids must be a TOML array")

    values: list[str] = []
    seen: set[str] = set()
    for item in raw:
        if not isinstance(item, str):
            raise ValueError("worker.gpu_uuids must contain only strings")
        uuid = item.strip()
        if not uuid:
            raise ValueError("worker.gpu_uuids must not contain blank values")
        if any(char.isspace() for char in uuid):
            raise ValueError("worker.gpu_uuids values must not contain whitespace")
        if uuid in seen:
            raise ValueError("worker.gpu_uuids must not contain duplicates")
        seen.add(uuid)
        values.append(uuid)

    if not values:
        raise ValueError(
            "generic GPU Worker setup requires at least one worker.gpu_uuids entry"
        )
    return tuple(values)


def load_preflight_mode(worker: dict[str, object]) -> str:
    value = worker.get("gpu_preflight_mode", "exact-visible")
    if not isinstance(value, str):
        raise ValueError("worker.gpu_preflight_mode must be a string")
    normalized = value.strip()
    if normalized not in {"exact-visible", "isolated-access"}:
        raise ValueError(
            "worker.gpu_preflight_mode must be exact-visible or isolated-access"
        )
    return normalized


def load_gpu_device_map(worker: dict[str, object]) -> str:
    value = worker.get("gpu_device_map", "")
    if not isinstance(value, str):
        raise ValueError("worker.gpu_device_map must be a string")
    return value.strip()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="astrumweaver-worker-gpu-uuids",
        description="Read the canonical GPU UUID sequence from worker.toml",
    )
    parser.add_argument("--config", required=True)
    parser.add_argument(
        "--field",
        choices=("gpu-uuids", "preflight-mode", "gpu-device-map"),
        default="gpu-uuids",
    )
    args = parser.parse_args(argv)

    try:
        worker = load_worker(Path(args.config))
        values = load_gpu_uuids(worker)
        preflight_mode = load_preflight_mode(worker)
        gpu_device_map = load_gpu_device_map(worker)
    except ValueError as exc:
        print(
            f"[astrumweaver-worker-gpu-uuids] ERROR: {exc}",
            file=sys.stderr,
        )
        return 2

    if args.field == "gpu-uuids":
        for value in values:
            print(value)
    elif args.field == "preflight-mode":
        print(preflight_mode)
    else:
        print(gpu_device_map)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
