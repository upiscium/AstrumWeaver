#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

die() {
  printf '[astrumweaver-gpu-device-map] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
usage:
  gpu-device-map [OPTIONS] discover EXPECTED_UUID_FILE
  gpu-device-map [OPTIONS] discover-visible
  gpu-device-map [OPTIONS] verify EXPECTED_UUID_FILE DEVICE_MAP_FILE

options:
  --nvidia-smi PATH  nvidia-smi executable (default: nvidia-smi)
  --proc-root PATH   NVIDIA GPU information root (default: /proc/driver/nvidia/gpus)
  --device-root PATH device-node root used for character-device checks (default: /dev)

discover prints canonical lines:
  GPU-uuid=/dev/nvidiaN

discover-visible prints the canonical mapping for every GPU currently visible
through nvidia-smi.

verify proves that every configured UUID still maps to the reviewed device node.
MIG device instances are intentionally outside this v0.x physical-GPU contract.
USAGE
  exit 2
}

NVIDIA_SMI="nvidia-smi"
PROC_ROOT="${ASTRUMWEAVER_GPU_PROC_ROOT:-/proc/driver/nvidia/gpus}"
DEVICE_ROOT="${ASTRUMWEAVER_GPU_DEVICE_ROOT:-/dev}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --nvidia-smi|--proc-root|--device-root)
      [[ $# -ge 2 ]] || usage
      case "$1" in
        --nvidia-smi) NVIDIA_SMI="$2" ;;
        --proc-root) PROC_ROOT="$2" ;;
        --device-root) DEVICE_ROOT="$2" ;;
      esac
      shift 2
      ;;
    discover|discover-visible|verify)
      break
      ;;
    *)
      usage
      ;;
  esac
done

[[ $# -ge 1 ]] || usage
MODE="$1"
shift

case "$MODE" in
  discover)
    [[ $# -eq 1 ]] || usage
    EXPECTED_FILE="$1"
    MAP_FILE=""
    ;;
  discover-visible)
    [[ $# -eq 0 ]] || usage
    EXPECTED_FILE=""
    MAP_FILE=""
    ;;
  verify)
    [[ $# -eq 2 ]] || usage
    EXPECTED_FILE="$1"
    MAP_FILE="$2"
    ;;
  *)
    usage
    ;;
esac

if [[ "$MODE" == "discover" || "$MODE" == "verify" ]]; then
  [[ -f "$EXPECTED_FILE" ]] || die "expected GPU UUID file is missing"
fi
if [[ "$MODE" == "verify" ]]; then
  [[ -f "$MAP_FILE" ]] || die "GPU device map file is missing"
fi
[[ "$PROC_ROOT" == /* ]] || die "GPU information root must be absolute"
[[ "$DEVICE_ROOT" == /* ]] || die "GPU device root must be absolute"
command -v "$NVIDIA_SMI" >/dev/null 2>&1 || die "nvidia-smi is not available"

expected_tmp="$(mktemp)"
visible_raw_tmp="$(mktemp)"
visible_tmp="$(mktemp)"
proc_tmp="$(mktemp)"
all_map_tmp="$(mktemp)"
map_tmp="$(mktemp)"
cleanup() {
  rm -f \
    "$expected_tmp" \
    "$visible_raw_tmp" \
    "$visible_tmp" \
    "$proc_tmp" \
    "$all_map_tmp" \
    "$map_tmp"
}
trap cleanup EXIT

if [[ "$MODE" == "discover" || "$MODE" == "verify" ]]; then
  if ! awk '
      {
        value=$0
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if (value == "" || value ~ /[[:space:],=]/) {
          invalid=1
        } else {
          print value
        }
      }
      END { if (invalid) exit 1 }
    ' "$EXPECTED_FILE" | sort >"$expected_tmp"; then
    die "expected GPU UUID file contains an invalid value"
  fi
  [[ -s "$expected_tmp" ]] || die "expected GPU UUID set is empty"
  if [[ -n "$(uniq -d "$expected_tmp")" ]]; then
    die "expected GPU UUID file contains duplicates"
  fi
fi

if ! "$NVIDIA_SMI" --query-gpu=uuid --format=csv,noheader >"$visible_raw_tmp"; then
  die "nvidia-smi GPU UUID visibility query failed"
fi
if ! awk '
    {
      value=$0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value == "") {
        next
      }
      if (value !~ /^GPU-[^[:space:],=]+$/) {
        invalid=1
      } else {
        print value
      }
    }
    END { if (invalid) exit 1 }
  ' "$visible_raw_tmp" | sort >"$visible_tmp"; then
  die "nvidia-smi returned an invalid visible GPU UUID"
fi

[[ -s "$visible_tmp" ]] || die "no visible GPU UUIDs were observed"
if [[ -n "$(uniq -d "$visible_tmp")" ]]; then
  die "visible GPU UUID set contains duplicates"
fi

shopt -s nullglob
information_files=("$PROC_ROOT"/*/information)
(( ${#information_files[@]} > 0 )) || die "NVIDIA GPU information entries are unavailable"
for information in "${information_files[@]}"; do
  if record="$(awk -F: '
      $1 ~ /^[[:space:]]*GPU UUID[[:space:]]*$/ {
        value=$2
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if (uuid == "") uuid=value
      }
      $1 ~ /^[[:space:]]*Device Minor[[:space:]]*$/ {
        value=$2
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if (minor == "") minor=value
      }
      END { if (uuid != "") print uuid "|" minor }
    ' "$information")"; then
    if [[ -n "$record" ]]; then
      printf '%s\n' "$record" >>"$proc_tmp"
    fi
  fi
done

while IFS= read -r uuid; do
  count="$(awk -F'|' -v wanted="$uuid" '$1 == wanted { count++ } END { print count+0 }' "$proc_tmp")"
  [[ "$count" -eq 1 ]] || die "visible GPU UUID does not map to exactly one /proc entry"
  minor_raw="$(awk -F'|' -v wanted="$uuid" '$1 == wanted { print $2; exit }' "$proc_tmp")"
  [[ "$minor_raw" =~ ^[0-9]+$ ]] || die "visible GPU UUID has unsupported Device Minor"
  minor="$((10#$minor_raw))"
  device_path="$DEVICE_ROOT/nvidia${minor}"
  [[ -c "$device_path" ]] || die "visible GPU device node is not a character device: /dev/nvidia${minor}"
  printf '%s=/dev/nvidia%s\n' "$uuid" "$minor" >>"$all_map_tmp"
done <"$visible_tmp"

sort -o "$all_map_tmp" "$all_map_tmp"
if [[ -n "$(awk -F= '{ print $2 }' "$all_map_tmp" | sort | uniq -d)" ]]; then
  die "multiple visible GPU UUIDs map to one device node"
fi

if [[ "$MODE" == "discover-visible" ]]; then
  cp "$all_map_tmp" "$map_tmp"
else
  while IFS= read -r uuid; do
    if ! awk -F= -v wanted="$uuid" \
      '$1 == wanted { print; found++ } END { exit(found == 1 ? 0 : 1) }' \
      "$all_map_tmp" >>"$map_tmp"; then
      die "configured GPU UUID is not currently visible"
    fi
  done <"$expected_tmp"
  sort -o "$map_tmp" "$map_tmp"
fi

[[ -s "$map_tmp" ]] || die "GPU UUID/device mapping is empty"

if [[ "$MODE" == "discover" || "$MODE" == "discover-visible" ]]; then
  cat "$map_tmp"
  exit 0
fi

reviewed_tmp="$(mktemp)"
trap 'rm -f "$expected_tmp" "$visible_raw_tmp" "$visible_tmp" "$proc_tmp" "$all_map_tmp" "$map_tmp" "$reviewed_tmp"' EXIT
if ! awk -F= '
    {
      if (NF != 2) {
        invalid=1
        next
      }
      uuid=$1
      path=$2
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", uuid)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", path)
      if (uuid == "" || path == "") {
        invalid=1
      } else {
        print uuid "=" path
      }
    }
    END { if (invalid) exit 1 }
  ' "$MAP_FILE" | sort >"$reviewed_tmp"; then
  die "GPU device map contains an invalid line"
fi

if ! cmp -s "$map_tmp" "$reviewed_tmp"; then
  die "GPU UUID to device-node mapping changed"
fi

while IFS='=' read -r uuid path; do
  [[ "$path" =~ ^/dev/nvidia[0-9]+$ ]] || die "unsupported GPU device-node path"
  minor="${path##/dev/nvidia}"
  [[ -c "$DEVICE_ROOT/nvidia${minor}" ]] || die "GPU device node is not a character device: $path"
done <"$reviewed_tmp"

count="$(wc -l <"$reviewed_tmp" | tr -d ' ')"
printf '[astrumweaver-gpu-device-map] ok count=%s\n' "$count"
