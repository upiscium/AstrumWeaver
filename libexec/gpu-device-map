#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

die() {
  printf '[astrumweaver-gpu-device-map] ERROR: %s\n' "$*" >&2
  exit 1
}

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${ASTRUMWEAVER_GPU_MAPPING_PYTHON:-}" ]]; then
  MAPPING_PYTHON="$ASTRUMWEAVER_GPU_MAPPING_PYTHON"
elif [[ -f "$SCRIPT_DIR/gpu_mapping.py" ]]; then
  MAPPING_PYTHON="$SCRIPT_DIR/gpu_mapping.py"
elif [[ -f "$SCRIPT_DIR/../src/astrumweaver/validation/gpu_mapping.py" ]]; then
  MAPPING_PYTHON="$SCRIPT_DIR/../src/astrumweaver/validation/gpu_mapping.py"
else
  die "canonical GPU mapper is unavailable"
fi

PYTHON_BIN="${ASTRUMWEAVER_GPU_MAPPING_PYTHON_BIN:-python3}"
command -v "$PYTHON_BIN" >/dev/null 2>&1 || die "canonical GPU mapper runtime is unavailable"
exec "$PYTHON_BIN" "$MAPPING_PYTHON" "$@"
